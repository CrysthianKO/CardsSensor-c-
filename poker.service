[Unit]
Description=Servidor da Mesa de Poker e Scanner
After=network.target

[Service]
# Substitua "seu_usuario" pelo nome de usuário do Pi (ex: pi ou crys)
User=seu_usuario
WorkingDirectory=/home/seu_usuario/pasta_do_projeto
# Comando para iniciar o servidor (se usar o uv, coloque o caminho completo dele)
ExecStart=/home/seu_usuario/.cargo/bin/uv run servidor_mesa.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
