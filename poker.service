[Unit]
Description=Servidor da Mesa de Poker e Scanner
After=network.target

[Service]
# Substitua "seu_usuario" pelo nome de usuário do Pi (ex: pi ou crys)
User=uvinha
WorkingDirectory=/home/uvinha/CardsSensor-c-
# Comando para iniciar o servidor (se usar o uv, coloque o caminho completo dele)
ExecStartPre=+/usr/bin/nmcli connection up Hotspot
ExecStart=/usr/bin/python3 /home/uvinha/CardsSensor-c-/servidor_mesa.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
